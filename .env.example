# Browser login: identity project only. Never put server secrets in NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
TRADE_COMPANY_ID=

# Identity project: Auth sessions, members, roles, identity audit.
IDENTITY_PROJECT_REF=
IDENTITY_DATABASE_URL=
IDENTITY_DATABASE_CA_CERT=
# Server-only identity-project Auth Admin key, used only for employee account operations.
SUPABASE_AUTH_ADMIN_KEY=

# Independent business project: no employee, password, or role tables.
BUSINESS_PROJECT_REF=
BUSINESS_DATABASE_URL=
BUSINESS_DATABASE_CA_CERT=

# TRADE_DATABASE_URL / TRADE_DATABASE_CA_CERT are retired; runtime never falls back to them.

# Generate a private random value of at least 32 characters; never commit a real value.
LOGIN_RATE_LIMIT_SECRET=

# DeepSeek risk assistant: server-only, disabled until key, prices and budget are approved.
DEEPSEEK_RISK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_DAILY_BUDGET_USD_MICROS=0
DEEPSEEK_DAILY_CALL_LIMIT=0
DEEPSEEK_INPUT_USD_MICROS_PER_MILLION=0
DEEPSEEK_OUTPUT_USD_MICROS_PER_MILLION=0
DEEPSEEK_PRICES_VERIFIED_AT=

# Multi-model server policy; provider API keys are entered in the admin UI and encrypted.
AI_MODELS_ENABLED=false
# Base64-encoded 32-byte random key; keep a protected backup, never commit a real key.
AI_CREDENTIALS_ENCRYPTION_KEY=
AI_DAILY_BUDGET_USD_MICROS=0
AI_DAILY_CALL_LIMIT=0

# Brevo transactional email (human click-to-send only; never commit a real key).
# Used by server-side outreach_send_brevo. Not used by the Brevo MCP connector token.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Server-side maps lead search proxy (aiclient). Optional; defaults to the URL below.
# No Google Places key is needed here: aiclient owns the upstream Places integration.
LEADTOOL_BASE_URL=https://aiclient.reselat.de5.net
