# Copy to .env in this folder, chmod 600 .env. Values below are placeholders.
# HTTPS is required on LAN too (MFA, secure cookies and Web Crypto).
SITE_HOST=siliantai.example.internal
APP_ORIGIN=https://siliantai.example.internal
CADDY_CONFIG=./Caddyfile.lan
HTTP_BIND=0.0.0.0
NEXT_PUBLIC_SUPABASE_URL=https://siliantai.example.internal
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Official self-hosted Supabase Auth stack, joined through its private network.
IDENTITY_DOCKER_NETWORK=supabase_default
IDENTITY_SERVICE_URL=http://kong:8000
IDENTITY_PROJECT_REF=localidentity00000000
IDENTITY_DATABASE_HOST=identity-db
IDENTITY_DATABASE_TLS=disable
IDENTITY_DATABASE_URL=postgresql://identity_backend:REPLACE@identity-db:5432/postgres
SUPABASE_AUTH_ADMIN_KEY=
BUSINESS_PROJECT_REF=localbusiness00000000
BUSINESS_DATABASE_HOST=business-db
BUSINESS_DATABASE_TLS=disable
BUSINESS_DATABASE_URL=postgresql://business_backend:REPLACE@business-db:5432/postgres
BUSINESS_POSTGRES_PASSWORD=
TRADE_COMPANY_ID=
DEPLOYMENT_TARGET=self-hosted
FILE_STORAGE_DRIVER=filesystem
PRIVATE_FILES_ROOT=/data/private-files

# Generate a private random value of at least 32 characters; never commit a real value.
LOGIN_RATE_LIMIT_SECRET=

# Optional internet access for DeepSeek. Rules still work offline; defaults send nothing.
DEEPSEEK_RISK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_DAILY_BUDGET_USD_MICROS=0
DEEPSEEK_DAILY_CALL_LIMIT=0
DEEPSEEK_INPUT_USD_MICROS_PER_MILLION=0
DEEPSEEK_OUTPUT_USD_MICROS_PER_MILLION=0
DEEPSEEK_PRICES_VERIFIED_AT=

# Multi-model server policy; provider API keys are entered in the admin UI and encrypted.
AI_MODELS_ENABLED=false
# Base64-encoded 32-byte random key; keep a protected backup, never commit a real key.
AI_CREDENTIALS_ENCRYPTION_KEY=
AI_DAILY_BUDGET_USD_MICROS=0
AI_DAILY_CALL_LIMIT=0
