{
  "name": "trade-workstation",
  "version": "0.1.0",
  "author": "朱春茂",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pdf:sample": "vitest run tests/templates/render.test.ts",
    "test:local": "node scripts/start-local-test.mjs",
    "cf:build": "node scripts/cf-build-guard.mjs && opennextjs-cloudflare build && node scripts/cf-patch-pdf.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview --port 8791",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "next": "16.4.5",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.158.0"
  },
  "type": "module"
}
